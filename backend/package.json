{
  "name": "esxi-image-builder-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p . && esbuild ../frontend/app.ts --bundle --outfile=public/app.js && cp ../frontend/index.html public/index.html",
