    "start": "node dist/server.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "multer": "^2.0.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.2",
    "@types/uuid": "^9.0.8",
    "esbuild": "^0.21.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
